# Use the dedicated login created by scripts/configure_native_database.py.
DATABASE_URL=postgresql://crm_tungsten_app:YOUR_PASSWORD@HOST:PORT/crm_tungsten
PORT=3001
DB_POOL_MAX=5
SESSION_TTL_HOURS=12
# Railway production only:
# NODE_ENV=production

# Optional Meta integration
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_CHAT_SEND_ENABLED=false
META_CHAT_CHANNELS_JSON={}

# Optional Finance CRM integration
FINANCE_CRM_URL=
FINANCE_CRM_TOKEN=

# Required only for incoming external SocialLens webhooks
SOCIALLENS_WEBHOOK_SECRET=
